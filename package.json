{
  "name": "acantha",
  "version": "0.2.7",
  "private": true,
  "description": "A Git client with a commit graph, terminals and an editor",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/munsonlabs/acantha.git"
  },
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:web": "vp dev",
    "check": "vp check && vue-tsc --noEmit && vp build",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "tauri": "tauri",
    "prepare": "vp config",
    "test": "vp test",
    "icon": "node scripts/build-icon.mjs && tauri icon icon.svg -o src-tauri/icons && rm -rf src-tauri/icons/android src-tauri/icons/ios"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@iconify-json/catppuccin": "1.2.17",
    "@lezer/highlight": "1.2.5",
    "@replit/codemirror-vim": "6.4.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "codemirror": "6.0.2",
    "dompurify": "3.4.17",
    "gemoji": "8.1.0",
    "marked": "18.1.1",
    "shiki": "4.5.0",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "5.9.3",
    "vite-plus": "0.3.2",
    "vue-tsc": "3.2.5"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.2",
    "vitest": "4.1.11",
    "vue": "3.5.42"
  },
  "packageManager": "npm@11.11.1"
}
